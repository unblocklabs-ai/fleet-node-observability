# Legacy 0.1.x compatibility example for configure-openclaw-otel or print-otlp-env.
# The unified 0.2.0 agent reads a protected Authorization header file instead;
# do not extend this environment-based path for new nodes.

export FLEET_INGEST_TOKEN="REPLACE_WITH_NODE_INGEST_TOKEN"

# Node label, legacy network mode, service name, and OpenClaw config path are read
# from the node-local JSON file passed with --config, or from explicit CLI flags.

# Optional off-LAN Cloudflare Access headers. Leave unset for LAN nodes.
# export CF_ACCESS_CLIENT_ID="REPLACE_WITH_CF_ACCESS_CLIENT_ID"
# export CF_ACCESS_CLIENT_SECRET="REPLACE_WITH_CF_ACCESS_CLIENT_SECRET"
